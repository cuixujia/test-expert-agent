{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash",
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow"
    }
  },
  "mcp": {
    "my-local-mcp": {
      "type": "local",
      "command": ["npx", "-y", "my-mcp-command"],
      "enabled": false,
      "environment": {}
    },
    "my-remote-mcp": {
      "type": "remote",
      "url": "https://mcp.example.com/mcp",
      "enabled": false,
      "headers": {}
    }
  }
}
